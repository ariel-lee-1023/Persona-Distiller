{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "passages.json",
  "description": "Metadata inventory frozen before extraction. Group related works, excerpts and episodes together. Legacy ungrouped inputs are no longer accepted.",
  "type": "object",
  "required": [
    "passages"
  ],
  "additionalProperties": false,
  "properties": {
    "passages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
