{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona-distiller.local/schemas/evidence.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "situation": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "available_information": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "observed_event",
              "recurring_pattern",
              "editorial_synthesis",
              "new_application"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runtime_support": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "curation": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "preserve",
                  "contextualize",
                  "correct_or_remove",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "reason"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "source",
          "locator",
          "attribution",
          "group_id",
          "situation",
          "audience",
          "available_information",
          "constraints",
          "observation",
          "claim_type",
          "conditions",
          "exceptions",
          "conflicts",
          "runtime_support",
          "curation"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": true
}
