{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ariel-lee-1023/Persona-Distiller/main/references/schemas/fidelity.schema.json",
  "title": "fidelity.json",
  "description": "Results of the pre-assembly gates (run before Stage 4) and the final Stage 5 verification. Both phases are recorded so the curation loop is auditable. Mirror the same facts into the persona's transworld-identity/provenance.md in prose/table form. Release checks additionally reconcile hashes, partitions, item aggregates, baselines and conditional register gates; see ../release-evidence.md.",
  "type": "object",
  "required": [
    "content_hash",
    "split_hash",
    "registers_hash",
    "stale",
    "register_families",
    "isolation",
    "projection",
    "cost",
    "style",
    "behavioral"
  ],
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "projection.gate",
          "projection.final",
          "cost",
          "style",
          "discrimination",
          "register_selection"
        ]
      },
      "description": "Results invalidated by a later change and not yet re-run. Mark them at the moment of the change, not at the end, when it will be forgotten. Nothing that gated assembly may ship stale: a stale style-match result may ship if the staleness is stated in the coverage report, a stale projection or cost gate may not. An empty array asserts that every result matches the current package."
    },
    "register_families": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R[0-9]+$"
      },
      "description": "Family ids from registers.json, so per-family results below are readable without opening that file. Absent or single-element for a SINGLE_REGISTER corpus."
    },
    "projection": {
      "type": "object",
      "description": "Held-out projection test. The gate phase runs on top-ranked projectible regularities before assembly; the final phase re-checks the assembled core.",
      "required": [
        "gate",
        "final"
      ],
      "additionalProperties": false,
      "properties": {
        "gate": {
          "type": "object",
          "required": [
            "content_hash",
            "overall",
            "passed",
            "baseline",
            "hit_1",
            "hit_2",
            "fresh_context",
            "model",
            "settings",
            "baseline_prompt",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "passed": {
              "type": "boolean"
            },
            "recurations": {
              "type": "integer",
              "minimum": 0,
              "description": "How many re-curation loops the gate forced."
            },
            "note": {
              "type": "string",
              "description": "What changed between passes."
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "baseline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hit_1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hit_2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fresh_context": {
              "const": true
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "string",
              "minLength": 1
            },
            "baseline_prompt": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "prompt",
                  "answer",
                  "baseline_answer",
                  "score",
                  "baseline_score",
                  "rationale"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseline_answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ]
                  },
                  "baseline_score": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ]
                  }
                }
              }
            }
          }
        },
        "final": {
          "type": "object",
          "required": [
            "content_hash",
            "overall",
            "passed",
            "baseline",
            "hit_1",
            "hit_2",
            "fresh_context",
            "model",
            "settings",
            "baseline_prompt",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "by_domain": {
              "type": "object",
              "description": "Per-domain projection scores. Low scorers become explicit 'trust this less' caveats in the coverage report.",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "hit_2": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hit_1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "baseline": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "passed": {
              "type": "boolean"
            },
            "fresh_context": {
              "const": true
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "settings": {
              "type": "string",
              "minLength": 1
            },
            "baseline_prompt": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "prompt",
                  "answer",
                  "baseline_answer",
                  "score",
                  "baseline_score",
                  "rationale"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseline_answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ]
                  },
                  "baseline_score": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ]
                  }
                }
              }
            }
          }
        },
        "seed": {
          "type": "integer",
          "description": "Seed passed to holdout_split.py. Records the split so the test is repeatable."
        },
        "n_masked": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of masked passages. Must match n_masked in the split holdout_split.py produced."
        },
        "stratified": {
          "type": "boolean",
          "description": "Whether holdout_split.py --stratify distributed the mask across topic domains. Random masking over an uneven corpus concentrates the mask in the largest domain, and the resulting score is then read as though it described the persona."
        },
        "sampling_note": {
          "type": "string",
          "minLength": 1,
          "description": "How the mask was distributed, and which domains it did not reach. A score whose sampling is not described is a number without a denominator. Required in practice when stratified is false or absent."
        }
      }
    },
    "cost": {
      "type": "object",
      "description": "Cost/presence assertion. The hard minimum: if the corpus contains any high-signal cost-bearing refusal or interactional move, the core must contain at least one. Failing this blocks delivery.",
      "required": [
        "total_divergences",
        "slated_for_core",
        "in_core_final",
        "presence_assertion",
        "content_hash",
        "logged_out",
        "missing_unlogged"
      ],
      "additionalProperties": false,
      "properties": {
        "total_divergences": {
          "type": "integer",
          "minimum": 0,
          "description": "Every attested incentive-vs-characteristic divergence inventoried at Stage 2."
        },
        "slated_for_core": {
          "type": "integer",
          "minimum": 0,
          "description": "Confirmed by the cost gate before assembly."
        },
        "in_core_final": {
          "type": "integer",
          "minimum": 0,
          "description": "Actually present in the assembled core."
        },
        "logged_out": {
          "type": "integer",
          "minimum": 0,
          "description": "Dropped deliberately, with the reason logged."
        },
        "missing_unlogged": {
          "type": "integer",
          "minimum": 0,
          "description": "Dropped without a logged reason. Must be 0 at delivery — any non-zero value means go re-curate."
        },
        "presence_assertion": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ],
          "description": "'fail' blocks delivery. This is the most common way a core ends up articulate but generic."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "style": {
      "type": "object",
      "description": "Style-match test. Sample passages generated under the core's expression rules PLUS references/voice.md — that pair is the sustained-prose configuration, so that is what gets tested — re-measured with style_metrics.py and compared against held-out originals. At least one sample must be long enough to drift (400+ words); a voice that is right for three sentences and generic by the twelfth is the failure this test exists to catch.",
      "required": [
        "modulation_reproduced",
        "avoid_list_violations",
        "content_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "sentence_len_delta": {
          "type": "number",
          "minimum": 0,
          "description": "Normalised absolute difference from the held-out originals."
        },
        "hedge_rate_delta": {
          "type": "number",
          "minimum": 0
        },
        "avoid_list_violations": {
          "type": "integer",
          "minimum": 0,
          "description": "How many items from voice.md's 'What I never write' section appeared in the generated samples. A cheap binary-ish check that catches drift the distributions blur; anything above 0 means revise voice.md's rules or the generation configuration. Record 0 when the corpus supported no avoid-list."
        },
        "modulation_reproduced": {
          "type": "boolean",
          "description": "Whether register shifts under pressure/audience/stakes are reproduced, not just the averages. False is a real failure even when the averages match — the modulation is the individuating part."
        },
        "notes": {
          "type": "string"
        },
        "by_family": {
          "type": "object",
          "description": "Per-register-family deltas. In a MULTI_REGISTER corpus the pooled delta is the average of two comparisons and can look healthy while one family is badly off, which is the same averaging failure Pass A0 exists to prevent — one stage later.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "discrimination": {
      "type": "object",
      "description": "Blind register-separation gate, produced by scripts/discrimination_test.py. Mandatory whenever registers.json reports n_registers > 1, and re-triggered by any cluster merge — a merge is precisely the operation that can pool two registers into one module without anyone deciding to. Until 3.0 it ran only 'when the persona claims registers', which put the gate downstream of the distiller's own judgment: it fired only if someone had already noticed the thing it exists to detect. Omitted only for a SINGLE_REGISTER corpus, where the distance matrix in registers.json stands in its place. register_discover.py proposes and this test disposes: when they disagree, reduce the number of families rather than re-running discovery with a looser threshold until the numbers come out as expected.",
      "required": [
        "score",
        "n",
        "seed",
        "content_hash",
        "label_type"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of sampled passages correctly assigned to their register, classified blind. >=0.90 the registers are separable and per-register rules are load-bearing; 0.70-0.90 usable, but name the confusable pairs in the coverage report; <0.70 the registers are not distinct in this corpus — collapse them into one honest voice rather than shipping a distinction the persona cannot perform."
        },
        "n": {
          "type": "integer",
          "minimum": 2,
          "description": "Passages classified."
        },
        "seed": {
          "type": "integer",
          "description": "Sampling seed, so the split is reproducible."
        },
        "mask_names": {
          "type": "boolean",
          "description": "Whether capitalised mid-sentence tokens were masked. A score obtained with names visible may rest on recognising a cast rather than a register, and only the register survives into use."
        },
        "confusable_pairs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Register pairs confused more than once, e.g. 'c03->c01'. A pair confused repeatedly is one register, not two, whatever the labels say."
        },
        "required": {
          "type": "boolean",
          "description": "True when n_registers > 1 or a cluster merge triggered it. Recording the trigger is what makes an omission distinguishable from an oversight."
        },
        "merge_triggered": {
          "type": "boolean",
          "description": "True when this run was triggered by a cluster merge rather than by the initial family count."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "label_type": {
          "const": "register_family"
        },
        "confusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "actual",
              "predicted",
              "n"
            ],
            "properties": {
              "actual": {
                "type": "string",
                "minLength": 1
              },
              "predicted": {
                "type": "string",
                "minLength": 1
              },
              "n": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "split_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "registers_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "style_staleness_note": {
      "type": "string",
      "minLength": 1
    },
    "merge_triggered": {
      "type": "boolean"
    },
    "isolation": {
      "type": "object",
      "required": [
        "split_before_extraction",
        "construction_partitions",
        "test_exposures"
      ],
      "additionalProperties": false,
      "properties": {
        "split_before_extraction": {
          "const": true
        },
        "construction_partitions": {
          "const": [
            "train"
          ]
        },
        "test_exposures": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "register_selection": {
      "type": "object",
      "required": [
        "content_hash",
        "score",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "audience",
              "task",
              "stakes",
              "expected",
              "selected",
              "observed",
              "answer",
              "rationale"
            ],
            "additionalProperties": false,
            "properties": {
              "audience": {
                "type": "string",
                "minLength": 1
              },
              "task": {
                "type": "string",
                "minLength": 1
              },
              "stakes": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "selected": {
                "type": "string",
                "minLength": 1
              },
              "observed": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "merge_review": {
      "type": "string",
      "minLength": 1
    },
    "behavioral": {
      "type": "object",
      "required": [
        "content_hash",
        "reasoning",
        "commitment",
        "scope",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reasoning": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prompt",
              "answer",
              "criteria",
              "rationale",
              "disputed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "disputed": {
                "type": "boolean"
              }
            }
          }
        },
        "commitment": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prompt",
              "answer",
              "criteria",
              "rationale",
              "disputed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "disputed": {
                "type": "boolean"
              }
            }
          }
        },
        "scope": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prompt",
              "answer",
              "criteria",
              "rationale",
              "disputed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "disputed": {
                "type": "boolean"
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "required": [
            "candidates",
            "cases"
          ],
          "properties": {
            "candidates": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cases": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "prompt",
                  "answer",
                  "truth",
                  "judgments"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "truth": {
                    "type": "string",
                    "minLength": 1
                  },
                  "judgments": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": [
                        "reviewer",
                        "choice",
                        "blinded",
                        "disputed",
                        "rationale"
                      ],
                      "properties": {
                        "reviewer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "choice": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "blinded": {
                          "type": "boolean"
                        },
                        "disputed": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
