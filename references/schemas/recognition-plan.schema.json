{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persona-distiller.local/schemas/recognition-plan.schema.json",
  "type": "object",
  "properties": {
    "contract": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "period_domains": {
          "type": "string",
          "minLength": 1
        },
        "output_location": {
          "type": "string",
          "minLength": 1
        },
        "delivery_target": {
          "type": "string",
          "minLength": 1
        },
        "supplied_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "source_boundary": {
          "type": "object",
          "properties": {
            "priority_materials": {
              "type": "string",
              "minLength": 1
            },
            "reading_units": {
              "type": "integer",
              "minimum": 0
            },
            "ocr_pages": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "priority_materials",
            "reading_units",
            "ocr_pages"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "subject",
        "intended_use",
        "period_domains",
        "output_location",
        "delivery_target",
        "supplied_sources",
        "source_boundary"
      ],
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "fixed_background": {
            "type": "string",
            "minLength": 1
          },
          "stipulated_changes": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "characteristic",
              "changed_condition",
              "interpersonal"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "task",
          "fixed_background",
          "stipulated_changes",
          "kind",
          "references"
        ],
        "additionalProperties": true
      },
      "minItems": 3,
      "maxItems": 3
    },
    "profile": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "circumstances": {
            "type": "string",
            "minLength": 1
          },
          "observable_behavior": {
            "type": "string",
            "minLength": 1
          },
          "acceptable_variation": {
            "type": "string",
            "minLength": 1
          },
          "mismatch": {
            "type": "string",
            "minLength": 1
          },
          "diagnostic_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "scoring_anchors": {
            "type": "object",
            "properties": {
              "0": {
                "type": "string",
                "minLength": 1
              },
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              },
              "4": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "0",
              "1",
              "2",
              "3",
              "4"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "pattern",
          "circumstances",
          "observable_behavior",
          "acceptable_variation",
          "mismatch",
          "diagnostic_reason",
          "evidence_ids",
          "scoring_anchors"
        ],
        "additionalProperties": true
      },
      "minItems": 3,
      "maxItems": 5
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "situation": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "available_information": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "observed_event",
              "recurring_pattern",
              "editorial_synthesis",
              "new_application"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runtime_support": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "curation": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "preserve",
                  "contextualize",
                  "correct_or_remove",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "decision",
              "reason"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "source",
          "locator",
          "attribution",
          "group_id",
          "situation",
          "audience",
          "available_information",
          "constraints",
          "observation",
          "claim_type",
          "conditions",
          "exceptions",
          "conflicts",
          "runtime_support",
          "curation"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "generation": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "judge_models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "answer_max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "judge_max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "input_token_limit": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_words": {
          "const": 250
        }
      },
      "required": [
        "endpoint",
        "model",
        "judge_models",
        "temperature",
        "answer_max_tokens",
        "judge_max_tokens",
        "input_token_limit",
        "timeout_seconds",
        "deadline",
        "max_words"
      ],
      "additionalProperties": true
    },
    "identity_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structure_revision": {
      "const": 2,
      "description": "New writes use revision 2. Missing metadata identifies legacy inputs requiring inspection."
    },
    "assessment_scope": {
      "const": "transworld-identity/scope.md",
      "description": "Optional judge-only report, frozen with its actual bytes and separate hash."
    },
    "runtime_routes": {
      "type": "object",
      "not": {
        "required": [
          "scope"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "contract",
    "cases",
    "profile",
    "evidence",
    "generation",
    "structure_revision"
  ],
  "additionalProperties": true
}
